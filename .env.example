# Server Configuration
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
NODE_ENV=development

# Database
DB_PATH=./data/trading.db

# OpenAI API Key (required for AI chart analysis)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Finnhub API Key (for real-time market data, news, sentiment)
# Get your FREE API key from: https://finnhub.io/
FINNHUB_API_KEY=your-finnhub-api-key-here

# Anthropic API Key (for Claude AI - Trade Coach, Smart Signals, Market Analysis)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
